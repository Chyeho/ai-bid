      "body_page_start": 0,
      "body_page_end": 0,
      "body_text": "国义招标股份有限公司编制发布日期：2024年11月15日"
    },
    {
      "level": 1,
      "title": "第二部分采购项目内容",
      "pattern": "part",
      "page_start": 1,
      "page_end": 1,
